# ============================================================================
# env.example — template for .env  (ADR-0006)
# ============================================================================
#
# WHY THIS FILE EXISTS
#   .env is gitignored because it holds real passwords. That creates a gap:
#   nothing in Git records *which* variables the system needs. This file
#   closes that gap — it is the committed contract, with placeholder values.
#
#   Rule: .env is NEVER edited by hand. Run `make setup`, which generates
#   secrets and fills them in. Hand-editing is how .env files drift into an
#   undocumented mess that nobody can reconstruct — the exact failure that
#   makes migrating to SOPS (M7) painful instead of trivial.
#
# HOW TO USE
#   make setup          # creates .env from this file, generates secrets
#   make check-env      # verifies .env has every key this file declares
#
# SECURITY
#   .env is chmod 600, owner deploy. On the server it lives at
#   /opt/life-server/.env and is read only by Docker Compose.
#   It is NOT in Git -> it MUST be in backups (M5). See ADR-0006.
# ============================================================================

# ── Core identity ───────────────────────────────────────────────────────────
# ENV drives hostname derivation and all resource prefixes (ADR-0010).
#   prod -> n8n.maxrommel.de       containers: prod-postgres, prod-n8n
#   dev  -> n8n.dev.maxrommel.de   containers: dev-postgres,  dev-n8n
ENV=prod
DOMAIN=maxrommel.de

# Timezone for containers that log timestamps.
TZ=Europe/Berlin

# ── PostgreSQL (M4) ─────────────────────────────────────────────────────────
# Superuser. Only used for bootstrapping roles; no application uses it.
# Each service gets its own DB + role with no rights to other DBs (ADR-0005).
POSTGRES_SUPER_USER=postgres
POSTGRES_SUPER_PASSWORD=__GENERATE__

# Per-service credentials. Generated by `make setup`.
POSTGRES_N8N_PASSWORD=__GENERATE__
POSTGRES_PAPERCLIP_PASSWORD=__GENERATE__
POSTGRES_HERMES_PASSWORD=__GENERATE__

# ── Redis (M4) ──────────────────────────────────────────────────────────────
REDIS_PASSWORD=__GENERATE__

# ── Cloudflare Tunnel (M3) ──────────────────────────────────────────────────
# Token from: Cloudflare Zero Trust > Networks > Tunnels > create tunnel.
# This single token authenticates the tunnel; treat it like a password.
CLOUDFLARE_TUNNEL_TOKEN=__SET_MANUALLY__

# ── n8n (M6) ────────────────────────────────────────────────────────────────
# Encrypts stored credentials inside n8n. Losing this makes every credential
# n8n holds unrecoverable — it is one of the most important values here.
N8N_ENCRYPTION_KEY=__GENERATE__

# Owner account, claimed once via n8n's setup API (M6). Claiming it immediately
# is what closes the "anyone who finds the URL becomes owner" window — see
# docs/milestones/M6.md. This is n8n's OWN login, a second layer behind
# Cloudflare Access, not a replacement for it.
N8N_OWNER_EMAIL=max.rml@web.de
N8N_OWNER_PASSWORD=__GENERATE__

# ── Backups (M5) ────────────────────────────────────────────────────────────
# Restic repository password. Losing this makes every backup unreadable.
# Store it in your password manager the moment it is generated.
RESTIC_PASSWORD=__GENERATE__

# Where snapshots go. This is the ONE variable that moves backups off-host —
# nothing else changes when you switch destinations.
#
#   /srv/restic                                      local (see warning below)
#   sftp:u1234@u1234.your-storagebox.de:/backups     Hetzner Storage Box
#   s3:s3.eu-central-003.backblazeb2.com/<bucket>    Backblaze B2 / any S3
#
# S3-compatible destinations also need AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY here; restic reads them from the environment.
#
# WARNING: a local path is on the same disk as the data it protects, so it does
# NOT survive disk loss, host loss, or account loss — the failures backups exist
# for. ADR-0009 rejected local-only as the strategy. Acceptable only as a
# stepping stone while the pipeline is being proven; move it off-host before
# any service stores real data.
RESTIC_REPOSITORY=__SET_MANUALLY__

# ── Monitoring (M8) ─────────────────────────────────────────────────────────
# The ntfy topic doubles as a shared secret: anyone who knows the string can
# subscribe. It is therefore generated, not chosen, and it is the one path
# deliberately NOT gated by Cloudflare Access — the phone app cannot complete
# an Access login, so gating it would silently stop every alert.
NTFY_TOPIC=__GENERATE__

# Uptime Kuma's own admin login, created by scripts/seed-monitors.sh rather
# than through the first-run wizard — the wizard makes the first visitor the
# owner, and that window is exactly what M8 closed.
KUMA_ADMIN_USER=admin
KUMA_ADMIN_PASSWORD=__GENERATE__

# ntfy's own admin account. server.yml sets auth-default-access: deny-all, so
# without a real account nothing may publish or subscribe at all.
NTFY_ADMIN_USER=admin
NTFY_ADMIN_PASSWORD=__GENERATE__

# Two separate ntfy access tokens, deliberately not one shared token:
#   NTFY_PHONE_TOKEN  — read-only, lives on the phone. A stolen phone can read
#                       alerts; it cannot forge them.
#   NTFY_TOPIC_TOKEN  — publish rights, used by Uptime Kuma to send them.
# One token for both would mean a lost phone can publish fake all-clear
# notifications, which is the one message you must be able to trust.
NTFY_PHONE_TOKEN=__GENERATE__
NTFY_TOPIC_TOKEN=__GENERATE__

# A username/password for the phone as well, because the ntfy mobile app does
# not offer an access-token field in every version — observed 2026-07-31, where
# "Add user" accepted only user + password. Same read-only grant as the token:
#
#   ntfy access phone <NTFY_TOPIC> read-only
#
# Verified: read 200, publish 403. Do NOT put the admin account on the phone —
# admin is read-write, so a stolen phone could publish a forged "all clear",
# which is the one message that must be trustworthy.
NTFY_PHONE_USER=phone
NTFY_PHONE_PASSWORD=__GENERATE__

# ── Agents (M11, ADR-0020) ──────────────────────────────────────────────────
# Paperclip's own image, built by .github/workflows/paperclip-image.yml from a
# pinned upstream tag and pushed to our GHCR. Upstream publishes no server
# image, and this host has too little free memory to build a pnpm monorepo
# safely (2594 MB free of 3.7 GB, measured 2026-08-01).
#
# PIN BY DIGEST, NOT TAG. A tag can be moved; a digest cannot. ADR-0011 exists
# because "pinned" that can change underneath you is not pinned:
#
#   PAPERCLIP_IMAGE=ghcr.io/<owner>/paperclip@sha256:<64-hex>
#
# The workflow prints the exact line to paste, in its run summary.
PAPERCLIP_IMAGE=__SET_MANUALLY__

# Signs Paperclip's session cookies and agent JWTs. Upstream refuses to start
# without it rather than falling back to a default — correct, because a
# predictable signing key means forgeable sessions and issued agent tokens.
#
# Rotating it logs everyone out and invalidates issued agent keys, so treat it
# like a password: generated once, kept, never edited by hand.
BETTER_AUTH_SECRET=__GENERATE__

# The operator's Claude subscription token.
#
#   claude setup-token        # interactive, mints a long-lived token
#
# NOT an API key: this authenticates the Pro subscription, so agents cost
# nothing beyond it.
#
# ADR-0020 moved this OUT of the agent containers. It is now read by ONE
# service — the CLIProxyAPI container — which re-exports the subscription as a
# local OpenAI-compatible endpoint that Hermes and OpenClaw consume. One
# revocable secret in one place beats the same secret in three.
#
# THE ACCEPTED RISK, stated plainly: a successful prompt injection could spend
# quota. Accepted because the token is revocable in one click at claude.ai,
# while the things the sandbox protects — the board, n8n's integration keys,
# the age key — are not.
CLAUDE_CODE_OAUTH_TOKEN=__SET_MANUALLY__

# Gates the proxy's own endpoint. Without it, ANY container on net-agent could
# spend the subscription — including a prompt-injected agent session, which is
# exactly the scenario the sandbox exists for. Empty must fail closed.
PROXY_API_KEY=__GENERATE__

# Hermes gateway (the CEO). Paperclip authenticates to Hermes with this;
# upstream calls it API_SERVER_KEY. Distinct from the Paperclip agent key that
# Hermes uses in the other direction — reusing one value for both would mean a
# leak in either direction compromises both.
HERMES_GATEWAY_KEY=__GENERATE__

# OpenClaw gateway (the WhatsApp assistant). Sent as a bearer token over the
# WebSocket connect frame.
OPENCLAW_GATEWAY_KEY=__GENERATE__

# Where the heartbeat reports that the Claude credential still works.
#
# NOT generated: Uptime Kuma mints this when the `cliproxy` push monitor is
# created by scripts/seed-monitors.sh. Copy it from the monitor's page:
#
#   http://<PREFIX>status:3001/api/push/<token>
#
# Empty means the heartbeat container exits loudly rather than pretending to
# monitor. That is deliberate — a monitoring gap must be visible, and the whole
# point of this one is that the failure it catches is otherwise silent.
KUMA_PUSH_URL=__SET_MANUALLY__

# How often to prove the credential works. Hourly by default; the push monitor
# tolerates one missed report (3900s) so a restart does not page you.
HEARTBEAT_INTERVAL=3600

# HOW the credential is checked (M18, ADR-0027). This is the setting that
# decides whose budget an IDLE system spends.
#
# There is no token-free option. An earlier draft had one (`auth`, a GET on
# /v1/models) and it was REMOVED because it did not work: cliproxy answers that
# from its own static list, validating PROXY_API_KEY — a fixed string that
# cannot expire — and never contacts Anthropic. It reported healthy straight
# through the outage this monitor exists to catch. `auth` is now REJECTED with
# exit 1; do not reintroduce it.
#
#   router (default)  one real completion per hour, sent through omniroute
#                     against tier 2, so the tokens are billed to
#                     ANTHROPIC_API_KEY instead of the Pro plan.
#
#                     ⚠️ REQUIRES ANTHROPIC_API_KEY. Unkeyed, omniroute has only
#                     tier 1 and this silently becomes `full` — ~24 completions
#                     a day on your subscription. `make verify-subscription-load`
#                     fails on exactly that combination.
#
#   full              the same completion, sent to tier 1 directly, always on
#                     the Pro plan. The pre-M18 behaviour; opt-in only.
#
#   off               no check at all. Spends nothing, monitors nothing — an
#                     expired credential then shows up as agents silently
#                     failing, which is the M10 outage this monitor exists for.
#                     THIS IS THE ONLY MODE THAT COSTS AN IDLE SYSTEM NOTHING
#                     while tier 2 is unkeyed.
HEARTBEAT_MODE=router

# ── omniroute — the fallback model router (M13, ADR-0021) ────────────────────
# Every name here was read out of /app/.env.example inside
# diegosouzapw/omniroute:3.8.49. An earlier version of this file invented
# OMNIROUTE_DASHBOARD_ENABLED and friends — none of them exist, and an
# unrecognised env var is ignored in silence rather than rejected.
#
# Signs the router's own sessions and API keys.
OMNIROUTE_JWT_SECRET=__GENERATE__
OMNIROUTE_API_KEY_SECRET=__GENERATE__

# AES key for provider credentials at rest in SQLite. LOSING THIS MEANS
# RE-ENTERING EVERY PROVIDER — it is not recoverable from the database.
OMNIROUTE_STORAGE_KEY=__GENERATE__

# First-run admin password. The router insists on an account existing; the
# dashboard that would use it is not deployed (headless image), so this exists
# to stop the default "CHANGEME" from being the answer.
OMNIROUTE_INITIAL_PASSWORD=__GENERATE__

# Tier 2 of the router: a direct Anthropic key, used ONLY for requests the
# subscription refuses (it returns 400 above an account-wide token budget that
# OpenClaw's prompt exceeds — see ADR-0021).
#
# EMPTY IS A VALID, WORKING STATE — the router serves tier 1 alone. It is also
# the state in which OpenClaw still gets today's 400s, so an empty value here
# means the router is installed but not yet solving anything.
#
# Deliberately not one of the 90+ free provider tiers the router supports:
# these requests carry uni, work and job-application context, and "whichever
# vendor had quota left this hour" makes that data path unanswerable. One named
# counterparty instead. (ADR-0018 reason 1, which ADR-0021 upholds.)
#
# ⚠️ LEAVING THIS EMPTY IS WHAT MAKES AGENTS EAT THE PRO SUBSCRIPTION.
# All four agent paths (paperclip workers, openclaw, hermes, and the
# `subscription` combo) already route through omniroute. But the router has
# only ONE tier to route to while this is blank, so "routed through the
# router" and "billed to the Pro plan" are the same thing. Filling this in is
# the single change that moves load off the subscription; the free-provider
# pool cannot substitute for it, because it cannot do tool calling (ADR-0021).
# After setting it, run: ./scripts/omniroute-providers.sh
ANTHROPIC_API_KEY=

# The bearer OpenClaw presents to the router (its OPENAI_API_KEY). The router
# mints its own keys internally and has no config-file import path, so this
# value must be registered inside it after first start — see
# scripts/omniroute-providers.sh.
OMNIROUTE_API_KEY=__GENERATE__

# ── OpenClaw's access to other services (M15, ADR-0023) ──────────────────────
# Paperclip agent API key, bound to the Chief of Staff agent. Paperclip stores
# only sha256 of it, so the value cannot be recovered — regenerate by inserting
# a new row in agent_api_keys and revoking the old one (set revoked_at).
PAPERCLIP_AGENT_TOKEN=__GENERATE__

# n8n public API key. NOT generated: n8n mints it in Settings > n8n API and
# shows it exactly once. Empty is a valid state — the agent then simply cannot
# build workflows, rather than failing to start.
#
# NOTE: the key alone is not enough. n8n sits behind Cloudflare Access, which
# answers API calls to the public hostname with a 302 to its login page no
# matter how valid the key is. The agent therefore reaches n8n through Caddy
# with an explicit Host header — see N8N_URL / N8N_HOST_HEADER in compose.
N8N_API_KEY=

# Paperclip's REST API is company-scoped (/api/companies/<id>/issues). Read it
# from the companies table after onboarding; there is exactly one row.
PAPERCLIP_COMPANY_ID=__SET_MANUALLY__

# ── notify — the courier from agents to the operator (M16, ADR-0024) ─────────
# The operator's WhatsApp number, digits only, no + and no spaces. The courier
# refuses to start if this is not purely numeric — a typo here would otherwise
# surface as a confusing CLI error on the first real notification.
OPERATOR_WHATSAPP=__SET_MANUALLY__

# ── Telegram (M16) ───────────────────────────────────────────────────────────
# Bot token from @BotFather (/newbot). The channel is staged in
# openclaw.json but disabled while this is empty — enabling a channel with no
# token makes the gateway retry-loop against Telegram on every start.
TELEGRAM_BOT_TOKEN=
# The operator's NUMERIC Telegram id, from @userinfobot. Not the @username:
# usernames can be changed and reassigned, ids cannot.
TELEGRAM_ALLOW_FROM=

# Push URL for the omniroute monitor (M17). NOT generated: Uptime Kuma mints
# it when `make seed-monitors` creates the push monitor. Copy it from the
# monitor's page, same as KUMA_PUSH_URL. Empty means the router is simply not
# reported — it cannot be polled, because Kuma has no route to `agent`.
OMNIROUTE_PUSH_URL=

# ── LONGEVITY — Health Score Platform ────────────────────────────────────────
# GHCR image digests, set by the LONGEVITY deploy workflow.
# Pin by digest (ADR-0011): LONGEVITY_WEB_IMAGE=ghcr.io/.../longevity-frontend@sha256:<hex>
LONGEVITY_WEB_IMAGE=__SET_MANUALLY__
LONGEVITY_API_IMAGE=__SET_MANUALLY__

# Fastify session cookie signing key. 32+ bytes, base64.
LONGEVITY_SESSION_SECRET=__GENERATE__

# Ed25519 key pair for score-band tokens.
# Generate: openssl genpkey -algorithm ed25519 -out k.pem && openssl pkey -in k.pem -pubout
# Then paste the PEM content (including headers) as single-line with \n escapes, or use SOPS.
LONGEVITY_SIGNING_KEY_PRIVATE=__SET_MANUALLY__
LONGEVITY_SIGNING_KEY_PUBLIC=__SET_MANUALLY__

# Postgres role password for the `longevity` database (provisioned by initdb).
POSTGRES_LONGEVITY_PASSWORD=__GENERATE__

# Optional SMTP relay. Defaults to localhost (no mail) if unset.
LONGEVITY_SMTP_URL=

# Injected by the deploy workflow from the LONGEVITY superprojekt SHA.
LONGEVITY_COMMIT_SHA=
