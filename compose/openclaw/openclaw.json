{
  "agents": {
    "defaults": {
      "model": {
        "primary": "claude-subscription/claude-sonnet-5"
      },
      "skills": []
    }
  },
  "models": {
    "providers": {
      "claude-subscription": {
        "baseUrl": "${OPENAI_BASE_URL}",
        "apiKey": "${OPENAI_API_KEY}",
        "api": "openai-completions",
        "timeoutSeconds": 300,
        "models": [
          {
            "id": "claude-sonnet-5",
            "name": "Claude Sonnet 5",
            "reasoning": false,
            "input": [
              "text"
            ],
            "contextWindow": 200000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "channels": {
    "whatsapp": {
      "enabled": true,
      "dmPolicy": "allowlist",
      "allowFrom": [
        "491726024679"
      ],
      "groupPolicy": "disabled",
      "accounts": {
        "default": {
          "enabled": true
        }
      },
      "defaultAccount": "default"
    }
  },
  "messages": {
    "responsePrefix": "🤖"
  },
  "tools": {
    "profile": "messaging",
    "toolSearch": {
      "enabled": true,
      "mode": "directory"
    }
  },
  "plugins": {
    "allow": [
      "whatsapp"
    ],
    "entries": {
      "whatsapp": {
        "enabled": true
      }
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "port": 18789
  }
}
