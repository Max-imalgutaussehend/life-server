{
  "agents": {
    "defaults": {
      "model": {
        "primary": "omniroute/cliproxy/claude-sonnet-5"
      }
    }
  },
  "models": {
    "providers": {
      "omniroute": {
        "baseUrl": "${OPENAI_BASE_URL}",
        "apiKey": "${OPENAI_API_KEY}",
        "api": "openai-completions",
        "timeoutSeconds": 300,
        "models": [
          {
            "id": "cliproxy/claude-sonnet-5",
            "name": "Claude Sonnet 5",
            "reasoning": false,
            "input": [
              "text"
            ],
            "contextWindow": 200000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "channels": {
    "whatsapp": {
      "enabled": true,
      "dmPolicy": "allowlist",
      "allowFrom": [
        "491726024679"
      ],
      "groupPolicy": "disabled",
      "accounts": {
        "default": {
          "enabled": true
        }
      },
      "defaultAccount": "default"
    },
    "telegram": {
      "enabled": true,
      "dmPolicy": "allowlist",
      "allowFrom": [
        "${TELEGRAM_ALLOW_FROM}"
      ],
      "groupPolicy": "disabled",
      "accounts": {
        "default": {
          "enabled": true
        }
      },
      "defaultAccount": "default"
    }
  },
  "messages": {
    "responsePrefix": "\ud83e\udd16"
  },
  "tools": {
    "profile": "full",
    "toolSearch": {
      "enabled": true,
      "mode": "directory"
    }
  },
  "plugins": {
    "entries": {
      "whatsapp": {
        "enabled": true
      },
      "telegram": {
        "enabled": true
      }
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "port": 18789,
    "controlUi": {
      "allowedOrigins": [
        "https://openclaw.maxrommel.de"
      ]
    },
    "trustedProxies": [
      "172.20.3.0/24"
    ]
  }
}
