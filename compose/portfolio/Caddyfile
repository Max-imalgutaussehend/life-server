# =============================================================================
# Caddyfile — the portfolio's own file server. (M12)
# =============================================================================
#
# WHY A SECOND CADDY AND NOT A `file_server` IN THE MAIN ONE
#   The main Caddyfile is GENERATED from services.yml (ADR-0014). Teaching the
#   generator to emit a file-server block for one service would mean a second
#   kind of service in the registry — a special case that every future reader
#   has to learn. A tiny sidecar keeps the registry uniform: every entry is
#   still "a hostname that reverse-proxies to a container".
#
# WHY admin off
#   Same reason as the main proxy: the admin API can rewrite this config at
#   runtime, and nothing here ever needs to.
# =============================================================================

{
	auto_https off
	admin off
	log {
		output stdout
		format json
		level INFO
	}
}

http://:8080 {
	root * /srv/site
	file_server

	# The site is static and rebuilt only on deploy, so a long cache is safe
	# and keeps repeat visits off the origin entirely.
	# Five minutes, not an hour. This is three small files on a personal site —
	# the bandwidth saved by a long cache is meaningless, while the cost is real:
	# Cloudflare extends whatever it is told (an hour here became four at the
	# edge), so an edit stays invisible long enough to look like a broken deploy.
	@pdf path *.pdf
	@nonpdf not path *.pdf

	header @nonpdf Cache-Control "public, max-age=300"
	# The PDF gets no shared cache. Its response headers are load-bearing —
	# frame-ancestors decides whether the CV tab can embed it at all — and a
	# cached copy carries the OLD headers with it. Cloudflare served
	# `frame-ancestors 'none'` from cache long after the origin had switched
	# to 'self', including on a REVALIDATE, which is what kept the CV tab
	# showing its fallback. `no-cache` means revalidate every time; the file
	# is 105 KB on a personal site, so the cost is nil.
	header @pdf Cache-Control "no-cache"

	# This host serves files and nothing else. These headers cost nothing and
	# close the obvious classes of abuse for a page with no scripts at all.
	header X-Content-Type-Options "nosniff"
	# DENY on the HTML, but NOT on the PDF: Chrome renders an embedded PDF in
	# an internal frame, and DENY blocks that — the CV tab fell back to "your
	# browser cannot display the PDF inline" on a browser that plainly can.
	# SAMEORIGIN keeps other sites from framing the document while letting our
	# own page embed it.
	# Caddy's header directives are not applied in file order — a later
	# unmatched `header` still wins over an earlier matched one, which is why
	# a `@pdf` override placed after the generic DENY silently did nothing.
	# Both are matched instead, so neither can override the other.
	header @nonpdf X-Frame-Options "DENY"
	header @pdf X-Frame-Options "SAMEORIGIN"
	header Referrer-Policy "no-referrer"

	# NOTE ON "[email protected]": Cloudflare rewrites mailto: links at the
	# edge. The per-response opt-out headers (Email-Obfuscation, page-speed)
	# were tried here and are IGNORED — it is a zone setting only. The page
	# therefore avoids raw mailto: hrefs entirely; see index.html.
	# object-src 'self' is the one loosening of default-src 'none', and it is
	# what lets the CV tab embed its own PDF. Scoped to same-origin, so it
	# permits exactly one thing: a file served from this container. Historic
	# object-src abuse was about Flash and remote plugins — neither is
	# reachable from 'self' on a static file server with no scripts.
	# frame-ancestors is split the same way X-Frame-Options is, and for the
	# same reason — it was the second half of that bug. 'none' on the PDF says
	# "nobody may embed me", INCLUDING our own CV tab, and a CSP
	# frame-ancestors overrides X-Frame-Options where both are present. Fixing
	# only X-Frame-Options therefore changed nothing visible.
	header @nonpdf Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; object-src 'self'; frame-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	header @pdf Content-Security-Policy "default-src 'none'; frame-ancestors 'self'"

	# Health endpoint for the container healthcheck and Uptime Kuma.
	respond /healthz "ok" 200
}
