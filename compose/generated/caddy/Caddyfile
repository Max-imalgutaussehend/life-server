# WHY CADDY BINDS ONLY :80 AND ONLY INSIDE DOCKER (ADR-0003)
#   Cloudflare terminates TLS at the edge and reaches this container through
#   the tunnel, which is itself encrypted. Caddy therefore needs no
#   certificates and no host port. The compose service publishes NO ports, so
#   UFW needs no rule for 80/443 and the origin has zero public listeners.
#
#   `auto_https off` is required: without it Caddy would try to obtain
#   certificates for every site address and fail, because nothing can reach
#   it on :443 from outside.
#
#   THE `http://` PREFIX ON EACH SITE ADDRESS IS LOAD-BEARING.
#   A bare `host.example.com {` makes Caddy listen on :443 for that site EVEN
#   WITH auto_https off — the port is inferred from the address, not from the
#   TLS setting. The tunnel connects to caddy:80, so those sites would never
#   match and every request fell through to the :80 healthz block, returning
#   an empty 200. Cost hours to find; do not remove the prefix.
#
# HOSTNAMES ARE NOT HARDCODED
#   {$DOMAIN} and {$ENV_PREFIX} are resolved by Caddy at startup from the
#   environment (fed by .env). One generated file is therefore correct for
#   both prod and dev — no re-render on environment switch (ADR-0010).
#     prod: ENV_PREFIX=""      -> n8n.maxrommel.de
#     dev:  ENV_PREFIX=".dev"  -> n8n.dev.maxrommel.de

{
	auto_https off
	admin off
	log {
		output stdout
		format json
		level INFO
	}
}

# Health endpoint for the container's own healthcheck and for Uptime Kuma,
# plus the catch-all for unregistered hostnames.
#
# WHY THE 404 MATTERS
#   The tunnel's dashboard rule is a wildcard (*.domain), so EVERY subdomain
#   reaches Caddy — including ones with no service. Without an explicit 404
#   these fell through to the healthz block and returned an empty 200, which
#   looks like "it works" and hides typos. Unregistered hosts must fail loudly.
http://:80 {
	respond /healthz "ok" 200
	respond "no service registered for this hostname" 404
}

# ── n8n — Workflow automation and integration engine
#    access: private (Cloudflare Access enforces auth at the edge)
#    networks: apps, data
http://n8n{$ENV_PREFIX}.{$DOMAIN} {
	# Upstream is the container name, resolved by Docker's embedded DNS.
	# {$ENV_PREFIX_NAME} yields e.g. "prod-" so the target is prod-n8n.
	reverse_proxy {$ENV_PREFIX_NAME}n8n:5678 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto https
	}

	log {
		output stdout
		format json
	}
}

