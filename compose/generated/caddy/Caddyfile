# ── longevity — LONGEVITY — Health Score Platform (DHBW MVP)
#    access: public
#    networks: apps, data
http://longevity{$ENV_PREFIX}.{$DOMAIN} {
	# Upstream is the container name, resolved by Docker's embedded DNS.
	# {$ENV_PREFIX_NAME} yields e.g. "prod-" so the target is prod-longevity.
	# Split routing: /api/* -> longevity-api:3000, rest -> longevity:8082
	handle /api/* {
		reverse_proxy {$ENV_PREFIX_NAME}longevity-api:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto https
		}
	}
	handle {
		reverse_proxy {$ENV_PREFIX_NAME}longevity:8082 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto https
		}
	}

	log {
		output stdout
		format json
	}
}

