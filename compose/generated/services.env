OPENCLAW_HOST=openclaw${ENV_PREFIX}.${DOMAIN}
OPENCLAW_PORT=18789
OPENCLAW_CONTAINER=${ENV_PREFIX_NAME}openclaw
OPENCLAW_HEALTHCHECK=/
OPENCLAW_ENABLED=true

