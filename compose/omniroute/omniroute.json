{
  "server": {
    "port": 20128,
    "host": "0.0.0.0",
    "auth": {
      "apiKey": "${OMNIROUTE_API_KEY}"
    }
  },
  "dashboard": {
    "enabled": false
  },
  "memory": {
    "enabled": false
  },
  "semanticCache": {
    "enabled": false
  },
  "telemetry": {
    "enabled": false
  },
  "stealth": {
    "enabled": false
  },
  "providers": {
    "claude-subscription": {
      "tier": 1,
      "baseUrl": "${CLIPROXY_BASE_URL}",
      "apiKey": "${CLIPROXY_API_KEY}",
      "api": "openai-completions",
      "timeoutSeconds": 300,
      "models": {
        "claude-sonnet-5": {
          "contextWindow": 200000,
          "maxTokens": 8192
        }
      }
    },
    "anthropic-direct": {
      "tier": 2,
      "enabled": false,
      "baseUrl": "https://api.anthropic.com/v1",
      "apiKey": "${ANTHROPIC_API_KEY}",
      "api": "anthropic-messages",
      "timeoutSeconds": 300,
      "models": {
        "claude-sonnet-5": {
          "contextWindow": 200000,
          "maxTokens": 8192
        }
      }
    }
  },
  "routing": {
    "strategy": "tiered-failover",
    "tiers": [
      ["claude-subscription"],
      ["anthropic-direct"]
    ],
    "retry": {
      "maxAttempts": 2,
      "retryOnStatus": [400, 429, 500, 502, 503, 529]
    },
    "circuitBreaker": {
      "enabled": true,
      "failureThreshold": 3,
      "cooldownSeconds": 60
    }
  }
}
