{# Template -> compose/generated/services.env  (ADR-0010, ADR-0014) #}
# =============================================================================
# GENERATED FILE — DO NOT EDIT
# Source:    {{ registry }}
# Generator: {{ generator }}
# Regenerate: make generate
# =============================================================================
#
# WHAT THIS IS
#   Derived, non-secret variables: hostnames, ports and container names for
#   every registered service. Compose loads this alongside .env.
#
#   Split rationale — this file is generated and committed; .env is secret and
#   gitignored. Keeping them separate means hostnames stay reviewable in Git
#   while passwords never touch it (ADR-0006).
#
# WHY VALUES REFERENCE ${DOMAIN} INSTEAD OF EXPANDING IT
#   Expansion happens at container start, not at render time. The same
#   committed file is therefore correct for prod and dev; only ENV_PREFIX
#   differs. Nothing here hardcodes a hostname.

# ── Derived prefixes ────────────────────────────────────────────────────────
# Set by scripts/setup-env.sh from ENV:
#   ENV=prod -> ENV_PREFIX=""      ENV_PREFIX_NAME="prod-"
#   ENV=dev  -> ENV_PREFIX=".dev"  ENV_PREFIX_NAME="dev-"
# ENV_PREFIX      -> DNS infix    (n8n.dev.maxrommel.de)
# ENV_PREFIX_NAME -> object names (dev-n8n, dev-postgres, dev-net-data)

{% for svc in services %}
# ── {{ svc.name }}{% if not svc.enabled %}  [NOT DEPLOYED — enabled:false]{% endif %}

# {{ svc.description }}
{{ svc.env_key }}_HOST={{ svc.name }}${ENV_PREFIX}.${DOMAIN}
{{ svc.env_key }}_PORT={{ svc.port }}
{{ svc.env_key }}_CONTAINER=${ENV_PREFIX_NAME}{{ svc.name }}
{{ svc.env_key }}_HEALTHCHECK={{ svc.healthcheck }}
{{ svc.env_key }}_ENABLED={{ 'true' if svc.enabled else 'false' }}

{% endfor %}
