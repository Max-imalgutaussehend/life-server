# Consistent formatting regardless of editor. Prevents whitespace-only diffs
# that obscure real changes in review.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Tabs are syntactically required in Makefiles.
[Makefile]
indent_style = tab

# Caddy's native format uses tabs.
[Caddyfile*]
indent_style = tab

[*.py]
indent_size = 4

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false
