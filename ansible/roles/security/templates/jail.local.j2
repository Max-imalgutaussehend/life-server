# {{ ansible_managed }}
# fail2ban jail configuration. Edit ansible/roles/security, not this file.
#
# With password auth disabled, fail2ban's role is narrower than usual: it
# mainly cuts log noise and stops repeated key-probing. Kept because it costs
# nothing and covers future services that do accept passwords.

[DEFAULT]
bantime  = {{ fail2ban_bantime }}
findtime = {{ fail2ban_findtime }}
maxretry = {{ fail2ban_maxretry }}
backend  = systemd
# Never ban loopback or Docker's default bridge range.
#
# fail2ban_ignore_extra holds the operator's own address(es). This is not a
# convenience: `mode = aggressive` counts a closed connection as a failure, so
# a deploy — which opens several SSH sessions in a row — can ban the very
# machine that runs it. That happened on 2026-08-24 and cost an hour, because
# the symptom (`Connection refused`) is indistinguishable from a dead sshd.
#
# A home IP changes, so this is a variable rather than a committed address:
# set it in group_vars/all.yml, or leave it empty on a host you administer
# from somewhere else.
ignoreip = 127.0.0.1/8 ::1 172.16.0.0/12{% if fail2ban_ignore_extra %} {{ fail2ban_ignore_extra }}{% endif %}

[sshd]
enabled  = true
port     = {{ ssh_port }}
mode     = aggressive
